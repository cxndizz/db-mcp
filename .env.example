# Copy to .env and adjust. NO passwords here — those go in the OS keyring via
# `oracle-mcp set-password`. This file is safe to keep local but is gitignored.

# Query guards
ORACLE_MAX_ROWS=200
ORACLE_HARD_MAX_ROWS=5000
ORACLE_QUERY_TIMEOUT=30
ORACLE_EXPLAIN_COST_LIMIT=1000000
ORACLE_MAX_CONCURRENCY=4

# Audit log
AUDIT_LOG_PATH=./logs/audit.jsonl

# HTTP mode (ChatGPT / remote) — required when running with --http
# MCP_HTTP_TOKEN=change-me-to-a-long-random-token

# Override store locations only if auto-discovery misses them
# DBEAVER_WORKSPACE=C:\Users\you\AppData\Roaming\DBeaverData\workspace6\General
# SQLDEV_SYSTEM_DIR=C:\Users\you\AppData\Roaming\SQL Developer\system26.2.0.186.2220

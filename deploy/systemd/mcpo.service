[Unit]
Description=mcpo (MCP -> OpenAPI proxy) for Open WebUI
After=network-online.target db-mcp.service
Wants=network-online.target
Requires=db-mcp.service

[Service]
Type=simple
User=dbmcp
Group=dbmcp
EnvironmentFile=/etc/db-mcp/env
Environment=HOME=/var/lib/db-mcp
Environment=UV_CACHE_DIR=/var/lib/db-mcp/cache
# NOTE: pin Python 3.12 and EXACT mcpo+mcp versions. Without exact pins, uv can
# resolve (from cache) an mcp that lacks `streamablehttp_client`, so mcpo fails
# to import. This pair is verified working together; bump deliberately.
# Bind 0.0.0.0 so the Open WebUI *container* can reach it via
# host.docker.internal; keep port 8001 CLOSED in firewalld (internal only).
# No quotes around the specs: systemd does NOT strip double-quotes like bash, so
# "mcp==2.3.0" would be passed with literal quotes and the pin silently ignored
# (-> a broken mcp). The specs have no spaces, so quotes are unnecessary.
ExecStart=/usr/local/bin/uvx --python 3.12 --from mcpo==0.0.20 --with mcp==2.3.0 mcpo \
  --host 0.0.0.0 --port 8001 \
  --api-key ${MCPO_API_KEY} \
  --config /etc/db-mcp/mcpo.config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/db-mcp
PrivateTmp=true

[Install]
WantedBy=multi-user.target

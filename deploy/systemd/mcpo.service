[Unit]
Description=mcpo (MCP -> OpenAPI proxy) for Open WebUI
After=network-online.target db-mcp.service
Wants=network-online.target
Requires=db-mcp.service

[Service]
Type=simple
User=dbmcp
Group=dbmcp
EnvironmentFile=/etc/db-mcp/env
Environment=HOME=/var/lib/db-mcp
Environment=UV_CACHE_DIR=/var/lib/db-mcp/cache
# NOTE: pin Python 3.12 and let mcpo choose its own `mcp`. Do NOT force an mcp
# version — a too-new mcp drops `streamablehttp_client` and mcpo fails to import
# (ImportError). A bleeding-edge Python (3.15) also caused bad resolutions.
# Bind 0.0.0.0 so the Open WebUI *container* can reach it via
# host.docker.internal; keep port 8001 CLOSED in firewalld (internal only).
ExecStart=/usr/local/bin/uvx --python 3.12 mcpo \
  --host 0.0.0.0 --port 8001 \
  --api-key ${MCPO_API_KEY} \
  --config /etc/db-mcp/mcpo.config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/db-mcp
PrivateTmp=true

[Install]
WantedBy=multi-user.target

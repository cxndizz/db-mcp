# Copy to /etc/db-mcp/env  (chmod 600, owned by the db-mcp service user).
# Loaded by the systemd units. NO secrets in git.

DB_MCP_CONNECTIONS=/etc/db-mcp/connections.json

# Per-connection password: DB_MCP_PW_<id>, id = connection id with every
# non-alphanumeric char -> "_", upper-cased.
#   127.0.0.1:15432/sandbox  ->  DB_MCP_PW_127_0_0_1_15432_SANDBOX
DB_MCP_PW_127_0_0_1_15432_SANDBOX=mcp_ro

# Guards / behaviour
ORACLE_AUTO_MASK=1
ORACLE_MAX_ROWS=200
ORACLE_QUERY_TIMEOUT=30
AUDIT_LOG_PATH=/var/log/db-mcp/audit.jsonl

# Internal bearer token for the db-mcp HTTP hop (mcpo -> db-mcp).
MCP_HTTP_TOKEN=change-me-long-random

# API key mcpo requires from Open WebUI.
MCPO_API_KEY=change-me-tool-key
